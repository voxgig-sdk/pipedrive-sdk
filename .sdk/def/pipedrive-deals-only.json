{
  "openapi": "3.0.3",
  "info": {
    "title": "Pipedrive Deals API",
    "version": "1.0.0",
    "description": "Create, read, update, and delete Pipedrive deals."
  },
  "servers": [
    { "url": "https://api.pipedrive.com/v1" }
  ],
  "security": [
    { "apiKeyAuth": [] }
  ],
  "paths": {
    "/deals": {
      "get": {
        "operationId": "listDeals",
        "summary": "List deals",
        "parameters": [
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "start", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "A page of deals",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Deal" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createDeal",
        "summary": "Create a deal",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DealInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created deal",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/Deal" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/deals/{id}": {
      "get": {
        "operationId": "getDeal",
        "summary": "Retrieve a deal",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "The requested deal",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/Deal" }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateDeal",
        "summary": "Update a deal",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DealInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated deal",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": { "$ref": "#/components/schemas/Deal" }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteDeal",
        "summary": "Delete a deal",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "query",
        "name": "api_token"
      }
    },
    "schemas": {
      "DealInput": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "value": { "type": "number" },
          "currency": { "type": "string" },
          "status": { "type": "string" },
          "stage_id": { "type": "integer" },
          "person_id": { "type": "integer" },
          "org_id": { "type": "integer" }
        }
      },
      "Deal": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "value": { "type": "number" },
          "currency": { "type": "string" },
          "status": { "type": "string" },
          "stage_id": { "type": "integer" },
          "person_id": { "type": "integer" },
          "org_id": { "type": "integer" },
          "add_time": { "type": "string" },
          "update_time": { "type": "string" }
        }
      }
    }
  }
}
