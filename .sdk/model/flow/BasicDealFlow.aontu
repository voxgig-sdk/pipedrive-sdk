# BasicDealFlow

main: kit: flow: BasicDealFlow:
{
  entity: "deal",
  kind: "basic",
  name: "BasicDealFlow",
  step: [
    {
      input: {
        ref: "deal_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "deal_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "deal_ref01",
        srcdatavar: "deal_ref01_data",
        suffix: "_up0",
        textfield: "add_time"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-deal_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "deal_ref01",
        srcdatavar: "deal_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "deal01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-deal_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "deal_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "deal01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "deal_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDealFlow"
}