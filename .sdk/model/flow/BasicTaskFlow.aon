# BasicTaskFlow

main: kit: flow: BasicTaskFlow:
{
  entity: "task",
  kind: "basic",
  name: "BasicTaskFlow",
  step: [
    {
      input: {
        ref: "task_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "task_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "task_ref01",
        srcdatavar: "task_ref01_data",
        suffix: "_up0"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-task_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "task_ref01",
        srcdatavar: "task_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "task01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-task_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "task_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "task01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "task_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTaskFlow"
}