# BasicLegacyTeamFlow

main: kit: flow: BasicLegacyTeamFlow:
{
  entity: "legacy_team",
  kind: "basic",
  name: "BasicLegacyTeamFlow",
  step: [
    {
      input: {
        ref: "legacy_team_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "legacy_team_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "legacy_team_ref01",
        srcdatavar: "legacy_team_ref01_data",
        suffix: "_up0",
        textfield: "description"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-legacy_team_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "legacy_team_ref01",
        srcdatavar: "legacy_team_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "legacy_team01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-legacy_team_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "legacy_team_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "legacy_team01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "legacy_team_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicLegacyTeamFlow"
}