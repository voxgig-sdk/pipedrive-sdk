# BasicLeadFlow

main: kit: flow: BasicLeadFlow:
{
  entity: "lead",
  kind: "basic",
  name: "BasicLeadFlow",
  step: [
    {
      input: {
        ref: "lead_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "lead_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "lead_ref01",
        srcdatavar: "lead_ref01_data",
        suffix: "_up0",
        textfield: "add_time"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-lead_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "lead_ref01",
        srcdatavar: "lead_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "lead01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-lead_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "lead_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "lead01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "lead_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicLeadFlow"
}