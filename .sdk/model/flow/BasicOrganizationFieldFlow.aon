# BasicOrganizationFieldFlow

main: kit: flow: BasicOrganizationFieldFlow:
{
  entity: "organization_field",
  kind: "basic",
  name: "BasicOrganizationFieldFlow",
  step: [
    {
      input: {
        ref: "organization_field_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "organization_field_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "organization_field_ref01",
        srcdatavar: "organization_field_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-organization_field_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "organization_field_ref01",
        srcdatavar: "organization_field_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "organization_field01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-organization_field_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "organization_field_ref01",
        suffix: "_rm0"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "organization_field_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicOrganizationFieldFlow"
}