# BasicFileFlow

main: kit: flow: BasicFileFlow:
{
  entity: "file",
  kind: "basic",
  name: "BasicFileFlow",
  step: [
    {
      input: {
        ref: "file_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "file_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "file_ref01",
        srcdatavar: "file_ref01_data",
        suffix: "_up0",
        textfield: "add_time"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-file_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "file_ref01",
        srcdatavar: "file_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "file01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-file_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "file_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "file01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "file_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicFileFlow"
}