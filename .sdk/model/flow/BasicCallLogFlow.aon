# BasicCallLogFlow

main: kit: flow: BasicCallLogFlow:
{
  entity: "call_log",
  kind: "basic",
  name: "BasicCallLogFlow",
  step: [
    {
      input: {
        ref: "call_log_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "call_log_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "call_log_ref01",
        srcdatavar: "call_log_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "call_log01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-call_log_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "call_log_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "call_log01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "call_log_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCallLogFlow"
}