# BasicFilterFlow

main: kit: flow: BasicFilterFlow:
{
  entity: "filter",
  kind: "basic",
  name: "BasicFilterFlow",
  step: [
    {
      input: {
        ref: "filter_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "filter_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "filter_ref01",
        srcdatavar: "filter_ref01_data",
        suffix: "_up0",
        textfield: "name"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-filter_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "filter_ref01",
        srcdatavar: "filter_ref01_data",
        suffix: "_dt0"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-filter_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "filter_ref01",
        suffix: "_rm0"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "filter_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicFilterFlow"
}