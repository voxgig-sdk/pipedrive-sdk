            json: "{\"operationId\":\"getLead\",\"parameters\":[{\"description\":\"The ID of the lead\",\"in\":\"path\",\"name\":\"id\",\"required\":true,\"schema\":{\"format\":\"uuid\",\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":{\"data\":{\"add_time\":\"2020-10-14T11:30:36.551Z\",\"cc_email\":\"company+1+leadntPaYKA5QRxXkh6WMNHiGh@dev.pipedrivemail.com\",\"channel\":52,\"channel_id\":\"Jun23 Billboards\",\"creator_id\":1,\"expected_close_date\":null,\"id\":\"adf21080-0e10-11eb-879b-05d71fb426ec\",\"is_archived\":false,\"label_ids\":[\"f08b42a0-4e75-11ea-9643-03698ef1cfd6\",\"f08b42a1-4e75-11ea-9643-03698ef1cfd6\"],\"next_activity_id\":1,\"organization_id\":null,\"origin\":\"API\",\"origin_id\":null,\"owner_id\":1,\"person_id\":1092,\"source_name\":\"API\",\"title\":\"Jane Doe Lead\",\"update_time\":\"2020-10-14T11:30:36.551Z\",\"value\":{\"amount\":999,\"currency\":\"USD\"},\"visible_to\":\"3\",\"was_seen\":false},\"success\":true},\"schema\":{\"properties\":{\"data\":{\"properties\":{\"add_time\":{\"description\":\"The date and time of when the lead was created. In ISO 8601 format: YYYY-MM-DDTHH:MM:SSZ.\",\"format\":\"date-time\",\"type\":\"string\"},\"cc_email\":{\"description\":\"The BCC email of the lead\",\"type\":\"string\"},\"channel\":{\"description\":\"The ID of your Marketing channel this Lead was created from. Recognized Marketing channels can be configured in your <a href=\\\"https://app.pipedrive.com/settings/fields\\\" target=\\\"_blank\\\" rel=\\\"noopener noreferrer\\\">Company settings</a>.\",\"nullable\":true,\"type\":\"integer\"},\"channel_id\":{\"description\":\"The optional ID to further distinguish the Marketing channel.\",\"nullable\":true,\"type\":\"string\"},\"creator_id\":{\"description\":\"The ID of the user who created the lead\",\"type\":\"integer\"},\"expected_close_date\":{\"description\":\"The date of when the deal which will be created from the lead is expected to be closed. In ISO 8601 format: YYYY-MM-DD.\",\"format\":\"date\",\"nullable\":true,\"type\":\"string\"},\"id\":{\"description\":\"The unique ID of the lead in the UUID format\",\"format\":\"uuid\",\"type\":\"string\"},\"is_archived\":{\"description\":\"A flag indicating whether the lead is archived or not\",\"type\":\"boolean\"},\"label_ids\":{\"description\":\"The IDs of the lead labels which are associated with the lead\",\"items\":{\"format\":\"uuid\",\"type\":\"string\"},\"type\":\"array\"},\"next_activity_id\":{\"description\":\"The ID of the next activity associated with the lead\",\"nullable\":true,\"type\":\"integer\"},\"organization_id\":{\"description\":\"The ID of an organization which this lead is linked to\",\"nullable\":true,\"type\":\"integer\"},\"origin\":{\"description\":\"The way this Lead was created. `origin` field is set by Pipedrive when Lead is created and cannot be changed.\",\"type\":\"string\"},\"origin_id\":{\"description\":\"The optional ID to further distinguish the origin of the lead - e.g. Which API integration created this Lead.\",\"nullable\":true,\"type\":\"string\"},\"owner_id\":{\"description\":\"The ID of the user who owns the lead\",\"type\":\"integer\"},\"person_id\":{\"description\":\"The ID of a person which this lead is linked to\",\"nullable\":true,\"type\":\"integer\"},\"source_deal_id\":{\"description\":\"The ID of the deal if the lead was converted from a deal.\",\"nullable\":true,\"type\":\"integer\"},\"source_name\":{\"description\":\"Defines where the lead comes from. Will be `API` if the lead was created through the Public API and will be `Manually created` if the lead was created manually through the UI.\\n\",\"type\":\"string\"},\"title\":{\"description\":\"The title of the lead\",\"type\":\"string\"},\"update_time\":{\"description\":\"The date and time of when the lead was last updated. In ISO 8601 format: YYYY-MM-DDTHH:MM:SSZ.\",\"format\":\"date-time\",\"type\":\"string\"},\"value\":{\"description\":\"The potential value of the lead represented by a JSON object: `{ \\\"amount\\\": 200, \\\"currency\\\": \\\"EUR\\\" }`. Both amount and currency are required.\",\"nullable\":true,\"properties\":{\"amount\":{\"type\":\"number\"},\"currency\":{\"type\":\"string\"}},\"required\":[\"amount\",\"currency\"],\"type\":\"object\"},\"visible_to\":{\"allOf\":[{\"enum\":[\"1\",\"3\",\"5\",\"7\"],\"type\":\"string\"}],\"description\":\"The visibility of the lead. If omitted, the visibility will be set to the default visibility setting of this item type for the authorized user.<table><tr><th>Value</th><th>Description</th></tr><tr><td>`1`</td><td>Owner &amp; followers (private)</td></tr><tr><td>`3`</td><td>Entire company (shared)</td></tr></table>\",\"type\":\"string\"},\"was_seen\":{\"description\":\"A flag indicating whether the lead was seen by someone in the Pipedrive UI\",\"type\":\"boolean\"}},\"title\":\"Lead\",\"type\":\"object\"},\"success\":{\"type\":\"boolean\"}},\"title\":\"GetLeadResponse\",\"type\":\"object\"}}},\"description\":\"Successful response containing payload in the `data` field\"},\"404\":{\"content\":{\"application/json\":{\"example\":{\"additional_data\":null,\"data\":null,\"error\":\"requested lead not found\",\"error_info\":\"Object was not found.\",\"success\":false},\"schema\":{\"properties\":{\"additional_data\":{\"example\":null,\"nullable\":true,\"type\":\"object\"},\"data\":{\"example\":null,\"nullable\":true,\"type\":\"object\"},\"error\":{\"description\":\"The description of the error\",\"type\":\"string\"},\"error_info\":{\"description\":\"A message describing how to solve the problem\",\"type\":\"string\"},\"success\":{\"example\":false,\"type\":\"boolean\"}},\"title\":\"LeadNotFoundResponse\",\"type\":\"object\"}}},\"description\":\"A resource describing an error\"}},\"security\":[{\"api_key\":[]},{\"oauth2\":[\"leads:read\",\"leads:full\"]}],\"securitySchemes\":{\"api_key\":{\"in\":\"header\",\"name\":\"x-api-token\",\"type\":\"apiKey\"},\"basic_a