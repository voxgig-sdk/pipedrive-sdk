ser can edit products\",\"type\":\"boolean\"},\"can_edit_shared_filters\":{\"description\":\"If the user can edit shared filters\",\"type\":\"boolean\"},\"can_export_data_from_lists\":{\"description\":\"If the user can export data from item lists\",\"type\":\"boolean\"},\"can_follow_other_users\":{\"description\":\"If the user can follow other users\",\"type\":\"boolean\"},\"can_merge_deals\":{\"description\":\"If the user can merge deals\",\"type\":\"boolean\"},\"can_merge_organizations\":{\"description\":\"If the user can merge organizations\",\"type\":\"boolean\"},\"can_merge_people\":{\"description\":\"If the user can merge people\",\"type\":\"boolean\"},\"can_modify_labels\":{\"description\":\"If the user can modify labels\",\"type\":\"boolean\"},\"can_see_company_wide_statistics\":{\"description\":\"If the user can see company-wide statistics\",\"type\":\"boolean\"},\"can_see_deals_list_summary\":{\"description\":\"If the user can see the summary on the deals page\",\"type\":\"boolean\"},\"can_see_hidden_items_names\":{\"description\":\"If the user can see the names of hidden items\",\"type\":\"boolean\"},\"can_see_other_users\":{\"description\":\"If the user can see other users\",\"type\":\"boolean\"},\"can_see_other_users_statistics\":{\"description\":\"If the user can see other users' statistics\",\"type\":\"boolean\"},\"can_see_security_dashboard\":{\"description\":\"If the user can see security dashboard\",\"type\":\"boolean\"},\"can_share_filters\":{\"description\":\"If the user can share filters\",\"type\":\"boolean\"},\"can_share_insights\":{\"description\":\"If the user can share insights\",\"type\":\"boolean\"},\"can_use_api\":{\"description\":\"If the user can use API\",\"type\":\"boolean\"},\"can_use_email_tracking\":{\"description\":\"If the user can use email tracking\",\"type\":\"boolean\"},\"can_use_import\":{\"description\":\"If the user can use import\",\"type\":\"boolean\"}},\"type\":\"object\"}},\"type\":\"object\"}],\"title\":\"GetUserPerm