            json: "{\"operationId\":\"addUser\",\"parameters\":[],\"protocol\":\"http\",\"requestBody\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"access\":{\"default\":[{\"app\":\"sales\"}],\"description\":\"The access given to the user. Each item in the array represents access to a specific app. Optionally may include either admin flag or permission set ID to specify which access to give within the app. If both are omitted, the default access for the corresponding app will be used. It requires structure as follows: `[{ app: 'sales', permission_set_id: '62cc4d7f-4038-4352-abf3-a8c1c822b631' }, { app: 'global', admin: true }, { app: 'account_settings' }]`\\n\",\"items\":{\"properties\":{\"admin\":{\"description\":\"Whether the user has admin access or not\",\"type\":\"boolean\"},\"app\":{\"description\":\"The granular app access level\",\"enum\":[\"global\",\"sales\",\"campaigns\",\"projects\",\"account_settings\",\"partnership\",\"nova\"],\"type\":\"string\"},\"permission_set_id\":{\"description\":\"The ID of the permission set\",\"type\":\"string\"}},\"required\":[\"app\"],\"title\":\"UserAccess\",\"type\":\"object\"},\"type\":\"array\"},\"active_flag\":{\"default\":true,\"description\":\"Whether the user is active or not. `false` = Not activated, `true` = Activated\",\"type\":\"boolean\"},\"email\":{\"description\":\"The email of the user\",\"type\":\"string\"}},\"required\":[\"email\"],\"title\":\"addUserRequest\",\"type\":\"object\"}}}},\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":{\"data\":{\"access\":[{\"admin\":false,\"app\":\"sales\",\"permission_set_id\":\"f07d229d-088a-4144-a40f-1fe64295d180\"},{\"admin\":true,\"app\":\"global\",\"permission_set_id\":\"233b7976-39bd-43a9-b305-ef3a2b0998e5\"}],\"activated\":true,\"active_flag\":true,\"created\":\"2019-01-22 10:43:47\",\"default_currency\":\"EUR\",\"email\":\"jane@pipedrive.com\",\"has_created_company\":false,\"icon_url\":null,\"id\":2,\"is_deleted\":false,\"