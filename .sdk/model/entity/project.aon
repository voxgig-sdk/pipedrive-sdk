            json: "{\"operationId\":\"getProjects\",\"parameters\":[{\"description\":\"For pagination, the marker (an opaque string value) representing the first item on the next page\",\"in\":\"query\",\"name\":\"cursor\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"For pagination, the limit of entries to be returned. If not provided, 100 items will be returned.\",\"in\":\"query\",\"name\":\"limit\",\"required\":false,\"schema\":{\"example\":100,\"type\":\"integer\"}},{\"description\":\"The ID of the filter to use\",\"in\":\"query\",\"name\":\"filter_id\",\"required\":false,\"schema\":{\"type\":\"integer\"}},{\"description\":\"If supplied, includes only projects with the specified statuses. Possible values are `open`, `completed`, `canceled` and `deleted`. By default `deleted` projects are not returned.\",\"in\":\"query\",\"name\":\"status\",\"required\":false,\"schema\":{\"example\":\"open,completed\",\"type\":\"string\"}},{\"description\":\"If supplied, only projects in specified phase are returned\",\"in\":\"query\",\"name\":\"phase_id\",\"required\":false,\"schema\":{\"type\":\"integer\"}},{\"description\":\"If supplied with `true` then archived projects are also included in the response. By default only not archived projects are returned.\",\"in\":\"query\",\"name\":\"include_archived\",\"required\":false,\"schema\":{\"type\":\"boolean\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"example\":{\"additional_data\":{\"next_cursor\":\"eyJhY3Rpdml0aWVzIjoyN30\"},\"data\":[{\"add_time\":\"2023-09-12 11:12:18.110\",\"archive_time\":\"2023-09-15 11:12:18.110\",\"board_id\":1,\"deal_ids\":[1,2],\"description\":\"Project Description\",\"end_date\":\"2024-03-04\",\"health_status\":10,\"id\":8,\"labels\":[13,14],\"org_id\":3,\"owner_id\":19,\"person_id\":2,\"phase_id\":1,\"start_date\":\"2023-09-18\",\"status\":\"open\",\"status_change_time\":\"2023-09-12 11:12:18.110\",\"title\":\"Project\",\"update_time