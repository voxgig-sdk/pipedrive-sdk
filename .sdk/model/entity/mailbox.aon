\"type\":\"integer\"}},\"type\":\"object\"},{\"properties\":{\"add_time\":{\"description\":\"The time when the mail thread was inserted to database\",\"format\":\"date-time\",\"type\":\"string\"},\"all_messages_sent_flag\":{\"allOf\":[{\"default\":0,\"enum\":[0,1],\"title\":\"numberBooleanDefault0\",\"type\":\"number\"}],\"description\":\"Whether all the mail thread messages have been sent\",\"type\":\"number\"},\"archived_flag\":{\"allOf\":[{\"default\":0,\"enum\":[0,1],\"title\":\"numberBooleanDefault0\",\"type\":\"number\"}],\"description\":\"Whether the mail thread is archived\"},\"deal_id\":{\"description\":\"The ID of the deal\",\"nullable\":true,\"type\":\"integer\"},\"deal_status\":{\"description\":\"Status of the deal\",\"nullable\":true,\"type\":\"string\"},\"drafts_parties\":{\"description\":\"Parties of the drafted mail thread\",\"items\":{\"type\":\"object\"},\"type\":\"array\"},\"external_deleted_flag\":{\"allOf\":[{\"default\":0,\"enum\":[0,1],\"title\":\"numberBooleanDefault0\",\"type\":\"number\"}],\"description\":\"Whether the mail thread has been deleted externally\"},\"first_message_timestamp\":{\"description\":\"The time when the mail thread has had the first message received or created\",\"format\":\"date-time\",\"type\":\"string\"},\"first_message_to_me_flag\":{\"allOf\":[{\"default\":0,\"enum\":[0,1],\"title\":\"numberBooleanDefault0\",\"type\":\"number\"}],\"description\":\"Whether the mail thread was initialized by others\"},\"folders\":{\"description\":\"Folders in which messages from thread are being stored\",\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"has_draft_flag\":{\"allOf\":[{\"default\":0,\"enum\":[0,1],\"title\":\"numberBooleanDefault0\",\"type\":\"number\"}],\"description\":\"Whether the mail thread has any drafts\",\"type\":\"number\"},\"has_sent_flag\":{\"allOf\":[{\"default\":0,\"enum\":[0,1],\"title\":\"numberBooleanDefault0\",\"type\":\"number\"}],\"description\":\"Whether the mail thread has messages sent\",\"type