# API Information


main: {
  kit: {
    info: {
      description: "The Pipedrive API v1."
      security: {
        in: "header"
        name: "Authorization"
        prefix: "Basic"
        scheme: "basic_authentication"
        type: "http"
      }
      servers: [
        {
          url: "https://api.pipedrive.com/v1"
        }
      ]
      title: "Pipedrive API v1"
      version: "1.0.0"
      website: "https://pipedrive.com"
    }
  }
}

