
# Model definitions.
@"@voxgig/apidef/model/apidef.aon"
@"@voxgig/sdkgen/model/sdkgen.aon"


# SDK Details.
name: 'pipedrive'
origin: 'voxgig-sdk'
def: 'pipedrive-deals-only.json'


# API Information
@"api/api-info.aon"


# SDK Configuration.
@"config.aon"


# SDK Entities
@"entity/entity-index.aon"


# SDK Features.
@"feature/feature-index.aon"
 

# SDK Targets.
@"target/target-index.aon"


# Operation workflows.
@"flow/flow-index.aon"


# Seneca provider plugin generates out-of-tree into the sibling repo.
main: kit: target: 'seneca-provider': output: {
  path: '../../seneca/pipedrive-provider'
  sdkrel: '../../voxgig-sdk/pipedrive-sdk'
}

